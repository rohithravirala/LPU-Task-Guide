# Copy this file to .env.local and fill in real values. Never commit .env.local.

# MongoDB connection string. Atlas: your cluster -> Connect -> Drivers, then replace
# <db_password> (URL-encode special characters, e.g. @ -> %40). Local: mongodb://127.0.0.1:27017/
MONGODB_URI=
# Database used when the URI does not name one (Atlas strings usually don't)
MONGODB_DB_NAME=lpu-uni-path

# JWT signing secret: a random string of at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend origins allowed to call the API with cookies
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth cookie settings. Use COOKIE_SAMESITE=none (+ HTTPS) only when the frontend and
# API are deployed on different sites; lax is correct for localhost and same-site deployments.
AUTH_COOKIE_NAME=lpu_uni_path_token
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Accounts created by `npm run seed` (development only)
SEED_ADMIN_NAME=Platform Admin
SEED_ADMIN_EMAIL=admin@unipath.local
SEED_ADMIN_PASSWORD=
SEED_STUDENT_NAME=Demo Student
SEED_STUDENT_EMAIL=student@unipath.local
SEED_STUDENT_PASSWORD=
