# Copy this file to .env.local and fill it in. Never commit .env.local.

# MongoDB Atlas connection string (Atlas -> your cluster -> Connect -> Drivers)
MONGODB_URI=
# Database inside the cluster
MONGODB_DB_NAME=Lpu-Uni-Path

# Secret used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Address of the React app (allowed by CORS in next.config.js)
FRONTEND_URL=http://localhost:5173

# Demo student created by `npm run seed` (an app password, never a real UMS password)
SEED_STUDENT_NAME=Demo Student
SEED_STUDENT_REG_NO=12345678
SEED_STUDENT_PASSWORD=
