# Used by `npm run build` (Vercel). The app calls its own /api, and frontend/vercel.json
# forwards /api/* to the backend (https://lpu-task-guide-backend.vercel.app), so the
# browser never calls another site and CORS is not needed.
# Local development (`npm run dev`) still uses .env (http://localhost:3000/api).
VITE_API_URL=/api
