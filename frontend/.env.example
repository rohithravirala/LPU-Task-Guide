# Copy to .env (or .env.local) and adjust.

# Base URL of the Next.js API (must include /api)
VITE_API_BASE_URL=http://localhost:3000/api

# Journey progress storage.
#   false -> saved on this device (localStorage) until Module 2 Part 2 ships the Progress API
#   true  -> saved to the student's account via /api/progress (see docs/api-and-routes.md)
VITE_PROGRESS_API_ENABLED=false
